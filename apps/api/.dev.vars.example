# Worker secrets for `wrangler dev` (copy to .dev.vars, never commit).
# Read-only B2 application key restricted to the bucket. Production values are set
# once with `wrangler secret put`; this key never goes to GitHub.
# B2_S3_ENDPOINT and B2_BUCKET are not secret: they live in wrangler.toml [vars].
B2_READ_KEY_ID=
B2_READ_APP_KEY=
