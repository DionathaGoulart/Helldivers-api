# Scraper configuration (copy to .env, never commit real keys).

# Only /wiki/<Title> and /images/... are fetched (arch §4.1).
WIKI_BASE_URL=https://helldivers.wiki.gg
# Base delay between requests; jitter and long pauses are added on top (arch §6.2).
SCRAPER_DELAY_MS=3000
# Identifiable User-Agent with the repo URL, no e-mail (plan D26).
SCRAPER_USER_AGENT="helldivers2-api-scraper (+https://github.com/DionathaGoulart/Helldivers-api)"
DATA_DIR=data

# Private Backblaze B2 bucket (path-style, bucket name is case-sensitive).
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_BUCKET=Helldivers-api
# Write key restricted to the bucket. Used by the scraper and scripts/b2-check.ts.
B2_WRITE_KEY_ID=
B2_WRITE_APP_KEY=
# Read key for `pnpm images:pull`, which copies the images into .cache/images for the build.
B2_READ_KEY_ID=
B2_READ_APP_KEY=
